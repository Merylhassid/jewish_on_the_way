{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jewishontheway.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jewishontheway.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
